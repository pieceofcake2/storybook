{
    "name": "pieceofcake2/storybook",
    "description": "Storybook for CakePHP 2 (development only): render Elements in Storybook (Vite), like Storybook for Symfony",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "storybook", "vite"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "autoload": {
        "classmap": ["Controller/", "Lib/"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Storybook"
    }
}
